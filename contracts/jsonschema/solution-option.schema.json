{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jlc-hardware-agent.local/schemas/solution-option.schema.json",
  "title": "SolutionOption",
  "description": "一套可比较的实现路线。canGenerate 为 false 时必须在 reason 里说明为什么不能生成，且不得产出占位文件。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "subtitle", "canGenerate", "reason", "designators", "nets", "parts", "unmet"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": ["template", "unsupported"],
      "description": "template 表示有真实生成器；unsupported 表示仅用于说明边界。"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "circuit": {
      "anyOf": [{ "type": "string" }, { "type": "null" }],
      "description": "电路拓扑的文本表达；无法生成时为 null。"
    },
    "circuitPlain": {
      "anyOf": [{ "type": "string" }, { "type": "null" }],
      "description": "同一拓扑的日常语言解释，给非工程用户看。"
    },
    "designators": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parts": {
      "type": "integer",
      "minimum": 0
    },
    "canGenerate": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "给用户看的理由，必须说清取舍或限制。"
    },
    "unmet": {
      "type": "array",
      "items": { "$ref": "#/$defs/UnmetRequirement" }
    }
  },
  "$defs": {
    "UnmetRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "message"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
