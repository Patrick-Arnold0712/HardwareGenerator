{
  "name": "jlc-hardware-agent",
  "version": "0.1.0",
  "private": true,
  "description": "MVP CLI that turns a constrained hardware request into a validated EasyEDA Pro .eprj3 project.",
  "main": "src/generate.js",
  "bin": {
    "jlc-hardware-agent": "src/generate.js"
  },
  "scripts": {
    "generate": "node src/generate.js --input \"5V LED 指示灯板\" --out dist --force",
    "test": "node --test test/mvp.test.js && node vendor/easyeda-eprj3-skill/test/smoke.js",
    "verify:client": "npm run generate && node src/verify-client.js --project \"dist/led-indicator/led-indicator.eprj3\"",
    "demo": "powershell -ExecutionPolicy Bypass -File scripts/demo.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
